# Dataset paths — update these to match your extracted CADDY dataset location
# The canonical CSVs are bundled inside CADDY_gestures_complete_v2_release.zip
CADDY_ROOT=./data/raw/caddy/CADDY_gestures_complete_v2_release
CADDY_CSV_POSITIVES=./data/raw/caddy/CADDY_gestures_complete_v2_release/CADDY_gestures_all_true_positives_release_v2.csv
CADDY_CSV_NEGATIVES=./data/raw/caddy/CADDY_gestures_complete_v2_release/CADDY_gestures_all_true_negatives_release_v2.csv

# Cache / derived data
ENHANCED_CACHE_DIR=./data/processed/enhanced
SPLITS_DIR=./data/processed/splits

# Pretrained weights
FUNIE_GAN_WEIGHTS=./weights/funie_gan/generator.pth
WATERNET_WEIGHTS=./weights/waternet/waternet.pth

# Experiment tracking
RUNS_DIR=./runs
CHECKPOINTS_DIR=./checkpoints

# Reproducibility
SEED=42

# Hardware
DEVICE=cuda
