# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment secrets
.env

# Data (large dataset files ignored, directory structure & .gitkeep preserved)
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/caddy/*
!data/raw/caddy/.gitkeep

data/processed/*
!data/processed/.gitkeep
!data/processed/*/
!data/processed/*.md
!data/processed/*.txt
data/processed/enhanced/*
!data/processed/enhanced/.gitkeep
data/processed/splits/*
!data/processed/splits/.gitkeep

# Pretrained weights binaries (placeholders preserved)
weights/*.pth
weights/**/*.pth
!weights/funie_gan/.gitkeep
!weights/waternet/.gitkeep

# Training artefacts (tensorboard logs, checkpoints ignored; placeholders preserved)
runs/*
!runs/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Jupyter
*.ipynb_checkpoints
.ipynb_checkpoints/

# Testing / linting caches
.pytest_cache/
.ruff_cache/
*.egg-info/
.eggs/

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.suo
*.user

# Academic thesis knowledge base (local only — never committed)
docs/thesis/
AGENTS.md
